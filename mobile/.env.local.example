# Supabase (필수: 설정 시 실 데이터, 없으면 mock 데이터 폴백)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Naver Map (NCP Web Dynamic Map v3 — 웹 NEXT_PUBLIC_NCP_MAP_CLIENT_ID 와 같은 Client ID)
# 미설정 시 Shop 지도는 일러스트 폴백. WebView baseUrl 은 NCP 등록 도메인이어야 함.
EXPO_PUBLIC_NCP_MAP_CLIENT_ID=
# (선택) NCP 콘솔에 등록된 웹 서비스 URL 오버라이드 (기본 https://poke-30.com)
# EXPO_PUBLIC_NCP_MAP_BASE_URL=

# Kakao OAuth (네이티브 빌드 시 필요)
EXPO_PUBLIC_KAKAO_NATIVE_KEY=
EXPO_PUBLIC_KAKAO_JS_KEY=
