{
  "expo": {
    "name": "아르보TCG",
    "slug": "pokefesta30",
    "version": "1.0.0",
    "orientation": "portrait",
    "newArchEnabled": false,
    "scheme": "pokefesta30",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#129782",
      "resizeMode": "cover"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.arvotcg.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "거래글·피드 게시물에 카드 사진을 첨부하기 위해 사진 보관함 접근이 필요합니다.",
        "NSCameraUsageDescription": "카드를 스캔하거나 촬영해 게시물에 첨부하려면 카메라 접근이 필요합니다.",
        "NSMicrophoneUsageDescription": "카메라 촬영 기능에 포함된 시스템 요구사항입니다. 음성은 수집하지 않습니다.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true,
          "NSExceptionDomains": {
            "synology.me": {
              "NSIncludesSubdomains": true,
              "NSExceptionAllowsInsecureHTTPLoads": true
            }
          }
        }
      },
      "buildNumber": "2"
    },
    "android": {
      "package": "com.arvotcg.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#129782"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "react-native-document-scanner-plugin",
        {
          "cameraPermission": "카드를 스캔하려면 카메라 접근이 필요합니다."
        }
      ],
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2c43f639-65c3-4f0f-a49c-7289bc28e232"
      }
    },
    "owner": "kimk1029"
  }
}
